  "panels": [
    {
      "type": "state-timeline",
      "title": "Raft role of every node",
      "description": "One row per node. Kill a leader (scripts/chaos.sh) and watch the row turn Follower while a Candidate appears and a new Leader is elected, typically in about a second.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "atc_raft_state{cluster=~\"$cluster\"}",
          "range": true,
          "refId": "A",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Follower",
                  "color": "blue",
                  "index": 0
                },
                "1": {
                  "text": "Candidate",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "LEADER",
                  "color": "green",
                  "index": 2
                },
                "3": {
                  "text": "Shutdown",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e93",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Leaders per cluster",
      "description": "Must be exactly 1 for every cluster. A dip to 0 is an election in progress; 2 would be split-brain, which Raft rules out.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (cluster) (atc_raft_is_leader{cluster=~\"$cluster\"})",
          "range": true,
          "refId": "A",
          "legendFormat": "{{cluster}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
